{
  "name": "open-in-totalcmd",
  "author": "lumine-code",
  "description": "Open files and folders in Total Commander.",
  "repository": "https://github.com/lumine-code/open-in-totalcmd",
  "bugs": {
    "url": "https://github.com/lumine-code/open-in-totalcmd/issues"
  },
  "keywords": [
    "total-commander",
    "file-manager",
    "windows",
    "file-browser"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "files": [
    "lib",
    "spec"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "open-external": {
      "versions": {
        "^1.0.0": "consumeOpenExternal"
      }
    }
  },
  "configSchema": {
    "path": {
      "title": "Executable Path",
      "description": "Path to Total Commander executable.",
      "type": "string",
      "default": "c:/Program Files/totalcmd/TOTALCMD64.EXE"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
